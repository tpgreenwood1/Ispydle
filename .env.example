# Neon pooled connection string
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Word difficulty tiers served, comma separated
ENABLED_TIERS=1
# Word length is shown once this many guesses are used (default 2)
LENGTH_REVEAL_AFTER=2
# Category hint unlocks once this many guesses are used (default 3)
CATEGORY_HINT_AFTER=3
# Longest answer served; longer words stay in the database but are skipped (default 6)
MAX_WORD_LEN=6
